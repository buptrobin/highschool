[
  ["scroll", "#b"],
  ["eval", "Array.from(document.querySelectorAll('svg')).map(function(s,i){var b=s.getBBox();var v=(s.getAttribute('viewBox')||'').split(/\\s+/).map(Number);return i+':x'+Math.round(b.x)+'-'+Math.round(b.x+b.width)+',y'+Math.round(b.y)+'-'+Math.round(b.y+b.height)+' vb'+v[2]+'x'+v[3]}).join(' | ')"]
]
