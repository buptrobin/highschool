[
  ["wait", 600],
  ["eval", "(function(){var b=document.querySelector('.bar'),s=document.querySelector('.stats'),st=document.querySelector('.stats .st');return 'bar='+getComputedStyle(b).display+' gap='+getComputedStyle(b).gap+' | stats='+getComputedStyle(s).display+' cols='+getComputedStyle(s).gridTemplateColumns+' gap='+getComputedStyle(s).gap+' | st='+getComputedStyle(st).display+' w='+Math.round(st.getBoundingClientRect().width);})()"],
  ["eval", "(function(){var i=document.querySelector('.bar input');return 'input flex='+getComputedStyle(i).flex+' w='+Math.round(i.getBoundingClientRect().width);})()"]
