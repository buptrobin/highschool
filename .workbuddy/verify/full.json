[
  ["wait", 700],
  ["eval", "['fig='+document.querySelectorAll('.gx-fig').length,'quote='+document.querySelectorAll('.gx-quote').length,'qa='+document.querySelectorAll('.qac').length,'err='+document.querySelectorAll('.er').length,'step='+document.querySelectorAll('#gxSteps .step').length,'svg='+document.querySelectorAll('svg').length].join(' ')"],
  ["eval", "(function(){var t=document.body.innerText,m=t.match(/简单来说|众所周知|其实很简单|只要记住/g);return m?('BANNED '+m.join(',')):'no banned words';})()"],
  ["eval", "(function(){var bad=[],n=0;document.querySelectorAll('svg').forEach(function(s,si){var vb=(s.getAttribute('viewBox')||'0 0 0 0').split(/\\s+/).map(Number);n++;s.querySelectorAll('text').forEach(function(t){var b;try{b=t.getBBox();}catch(e){return;}if(b.width===0)return;if(b.x<vb[0]-1||b.y<vb[1]-1||b.x+b.width>vb[0]+vb[2]+1||b.y+b.height>vb[1]+vb[3]+1){bad.push('f'+si+':\"'+t.textContent.slice(0,8)+'\"');}});});return n+' svg; '+(bad.length?bad.slice(0,10).join(', '):'geometry ok');})()"],
  ["eval", "document.documentElement.scrollWidth <= document.documentElement.clientWidth ? 'no x-overflow' : 'OVERFLOW '+document.documentElement.scrollWidth"],
  ["eval", "document.querySelector('#content') && document.querySelector('#content').children.length ? 'content ok' : 'EMPTY'"]
]
