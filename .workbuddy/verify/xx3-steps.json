[
  ["wait", 700],
  ["scroll", "#gxNext"],
  ["eval", "(function(){for(var i=0;i<4;i++){document.getElementById('gxNext').click();}return 'clicked 4';})()"],
  ["wait", 300],
  ["eval", "(function(){return 'visible='+document.querySelectorAll('#gxSteps .step:not([hidden])').length+' cnt='+document.getElementById('gxCnt').textContent+' ansHidden='+document.getElementById('gxAns').hidden;})()"],
  ["eval", "(function(){var t=document.getElementById('gxTr');t.value=100;t.dispatchEvent(new Event('input',{bubbles:true}));return 'r='+document.getElementById('gxVc').textContent+' '+document.getElementById('gxVs').textContent;})()"],
  ["eval", "(function(){var d=document.querySelector('#gxB path[stroke-width=\"2.4\"]').getAttribute('d').trim().split(/\\s+/);return 'curve end '+d.slice(-2).join(',');})()"],
  ["eval", "document.documentElement.scrollWidth <= document.documentElement.clientWidth ? 'no x-overflow' : 'OVERFLOW '+document.documentElement.scrollWidth"]
]
