[
  ["scroll", "#gxStage"],
  ["eval", "(function(){var vb=document.querySelector('#gxStage').viewBox.baseVal,bad=[];document.querySelectorAll('#gxStage text').forEach(function(t){var b=t.getBBox();if(b.x<-1||b.y<-1||b.x+b.width>vb.width+1||b.y+b.height>vb.height+1)bad.push(t.textContent+' '+Math.round(b.x)+','+Math.round(b.width));});return bad.join(' | ')||'text-bounds ok '+vb.width+'x'+vb.height})()"],
  ["eval", "(function(){var out=[];document.querySelectorAll('.stats .st').forEach(function(e){var v=e.querySelector('.v');if(v.scrollWidth>v.clientWidth+1)out.push(v.textContent+':'+v.scrollWidth+'>'+v.clientWidth);});return out.join(' | ')||'stats ok'})()"],
  ["eval", "'doc '+document.documentElement.scrollWidth+' vs '+window.innerWidth"]
]
