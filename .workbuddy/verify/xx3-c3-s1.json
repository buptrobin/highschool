[
  ["wait", 700],
  ["eval", "(function(){return 'init e='+document.getElementById('gxVa').textContent+' t='+document.getElementById('gxVb').textContent+' r='+document.getElementById('gxVc').textContent+' s='+document.getElementById('gxVs').textContent;})()"],
  ["eval", "(function(){var t=document.getElementById('gxTr');t.value=100;t.dispatchEvent(new Event('input',{bubbles:true}));return 't=100 -> r='+document.getElementById('gxVc').textContent+' '+document.getElementById('gxVs').textContent;})()"],
  ["eval", "(function(){var d=document.querySelector('#gxB path[stroke-width=\"2.4\"]').getAttribute('d').trim().split(/\\s+/);return 'curve end '+d.slice(-2).join(',');})()"],
  ["eval", "(function(){var e=document.getElementById('gxSl');e.value=80;e.dispatchEvent(new Event('input',{bubbles:true}));var t=document.getElementById('gxTr');t.value=0;t.dispatchEvent(new Event('input',{bubbles:true}));return '80/0 -> r='+document.getElementById('gxVc').textContent+' '+document.getElementById('gxVs').textContent;})()"],
  ["eval", "(function(){var e=document.getElementById('gxSl');e.value=30;e.dispatchEvent(new Event('input',{bubbles:true}));var t=document.getElementById('gxTr');t.value=20;t.dispatchEvent(new Event('input',{bubbles:true}));return '30/20 -> r='+document.getElementById('gxVc').textContent+' '+document.getElementById('gxVs').textContent;})()"],
  ["eval", "(function(){var bad=[],n=0;document.querySelectorAll('svg').forEach(function(s,si){var vb=(s.getAttribute('viewBox')||'0 0 0 0').split(/\\s+/).map(Number);n++;s.querySelectorAll('text').forEach(function(t){var b;try{b=t.getBBox();}catch(e){return;}if(b.width===0)return;if(b.x<vb[0]-1||b.y<vb[1]-1||b.x+b.width>vb[0]+vb[2]+1||b.y+b.height>vb[1]+vb[3]+1){bad.push('f'+si+':\"'+t.textContent.slice(0,8)+'\"');}});});return n+' svg; '+(bad.length?bad.slice(0,10).join(', '):'geometry ok after interaction');})()"],
  ["eval", "document.documentElement.scrollWidth <= document.documentElement.clientWidth ? 'no x-overflow' : 'OVERFLOW '+document.documentElement.scrollWidth"],
  ["eval", "(function(){var b=document.querySelector('#gxStBox');return 'state box bg='+b.style.background;})()"]
]
