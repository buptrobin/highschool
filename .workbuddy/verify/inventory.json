[
  ["wait", 700],
  ["eval", "['fig='+document.querySelectorAll('.gx-fig').length,'quote='+document.querySelectorAll('.gx-quote').length,'qa='+document.querySelectorAll('.qac').length,'err='+document.querySelectorAll('.er').length,'step='+document.querySelectorAll('#gxSteps .step').length,'stat='+document.querySelectorAll('.stats .st').length,'svg='+document.querySelectorAll('svg').length].join(' ')"],
  ["eval", "(function(){var t=document.body.innerText,m=t.match(/简单来说|众所周知|其实很简单|只要记住/g);return m?('BANNED '+m.join(',')):'no banned words';})()"],
  ["eval", "document.documentElement.scrollWidth <= document.documentElement.clientWidth ? 'no x-overflow' : 'OVERFLOW '+document.documentElement.scrollWidth"],
  ["eval", "document.querySelector('#content .empty') ? 'EMPTY PAGE' : 'content ok'"]
]
