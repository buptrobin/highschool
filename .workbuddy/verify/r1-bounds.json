[
  ["wait", 900],
  ["eval", "(function(){var bad=[];document.querySelectorAll('svg').forEach(function(s,si){var vb=(s.getAttribute('viewBox')||'0 0 0 0').split(/\\s+/).map(Number);s.querySelectorAll('rect,circle,ellipse,path,line,polygon').forEach(function(n){var b;try{b=n.getBBox();}catch(e){return;}if(b.width===0&&b.height===0)return;if(b.x<vb[0]-1||b.y<vb[1]-1||b.x+b.width>vb[0]+vb[2]+1||b.y+b.height>vb[1]+vb[3]+1)bad.push(si+':'+n.tagName+' '+Math.round(b.x)+','+Math.round(b.y)+' '+Math.round(b.width)+'x'+Math.round(b.height));});});return bad.length?bad.slice(0,12).join(' ; '):'shapes in bounds';})()"]
]
