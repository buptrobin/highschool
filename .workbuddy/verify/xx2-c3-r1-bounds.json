[
  ["scroll", "#gxStage"],
  ["eval", "(function(){var bad=[];document.querySelectorAll('#gxStage text').forEach(function(t){var b=t.getBBox();if(b.x<-1||b.y<-1||b.x+b.width>881||b.y+b.height>461)bad.push(t.textContent+' '+Math.round(b.x)+','+Math.round(b.width));});return bad.join(' | ')||'text-bounds ok'})()"],
  ["eval", "(function(){var out=[];document.querySelectorAll('.stats .st').forEach(function(e){var v=e.querySelector('.v');if(v.scrollWidth>v.clientWidth+1)out.push(v.textContent+':'+v.scrollWidth+'>'+v.clientWidth);});return out.join(' | ')||'stats ok'})()"],
  ["eval", "'doc '+document.documentElement.scrollWidth+' vs '+window.innerWidth"],
  ["shot", ".workbuddy/verify/xx2-c3-r1-c.png", "figure:nth-of-type(4)"]
]
