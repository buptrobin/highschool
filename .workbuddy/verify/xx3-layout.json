[
  ["wait", 800],
  ["eval", "(function(){var s=document.getElementById('gxStage');return 'viewBox='+s.getAttribute('viewBox')+' boardW='+Math.round(s.parentElement.getBoundingClientRect().width);})()"],
  ["eval", "(function(){var r=[];document.querySelectorAll('.stats .st').forEach(function(e){var b=e.getBoundingClientRect();r.push(Math.round(b.x)+','+Math.round(b.y)+' '+Math.round(b.width)+'x'+Math.round(b.height));});return 'stats '+r.join(' | ');})()"],
  ["eval", "(function(){var r=[];document.querySelectorAll('.bar > *').forEach(function(e){var b=e.getBoundingClientRect();r.push(e.tagName+' '+Math.round(b.x)+','+Math.round(b.y)+' '+Math.round(b.width)+'x'+Math.round(b.height));});return r.join(' | ');})()"],
  ["eval", "(function(){var t=document.querySelector('.bar input[type=range]');return t?('slider w='+Math.round(t.getBoundingClientRect().width)):'no slider';})()"],
  ["eval", "(function(){var a=document.querySelector('#gxStage').getBoundingClientRect(),b=document.querySelector('.stats').getBoundingClientRect();return 'stage bottom='+Math.round(a.bottom)+' stats top='+Math.round(b.top)+' gap='+Math.round(b.top-a.bottom);})()"],
  ["eval", "(function(){var w=document.querySelector('.page-wrap').getBoundingClientRect();return 'wrap '+Math.round(w.width)+' scrollH='+document.documentElement.scrollHeight;})()"],
  ["eval", "(function(){var bad=[];document.querySelectorAll('.gx-fig, .gx-qa, .gx-errs, .gx-cmp').forEach(function(e){var r=e.getBoundingClientRect();if(r.right>document.documentElement.clientWidth+1)bad.push(e.className+' '+Math.round(r.right));});return bad.length?bad.join(', '):'no bleed';})()"],
  ["eval", "document.querySelectorAll('#gxSteps .step:not([hidden])').length + ' visible steps'"]
]
