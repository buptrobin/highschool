  ["eval", "(function(){var s=document.getElementById('gxSl');var o=[];['4','6','7','10'].forEach(function(m){s.value=m;s.dispatchEvent(new Event('input'));o.push(m+'月 '+document.getElementById('gxVb').textContent);});return o.join(' | ');})()"],
  ["eval", "(function(){var s=document.getElementById('gxSl');s.value='7';s.dispatchEvent(new Event('input'));document.getElementById('gxP1').click();var a=document.getElementById('gxVs').textContent;return a==='赤道低压带'?'PASS 10N 7月 '+a:'FAIL '+a;})()"],
  ["eval", "(function(){var s=document.getElementById('gxSl');s.value='1';s.dispatchEvent(new Event('input'));document.getElementById('gxP1').click();var a=document.getElementById('gxVs').textContent;return a==='东北信风带'?'PASS 10N 1月 '+a:'FAIL '+a;})()"],
