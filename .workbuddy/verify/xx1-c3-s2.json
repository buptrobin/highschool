  ["eval", "(function(){var s=document.getElementById('gxSl');s.value='1';s.dispatchEvent(new Event('input'));document.getElementById('gxP3').click();var a=document.getElementById('gxVs').textContent;return a==='极地东风带'?'PASS 60N 1月 '+a:'FAIL '+a;})()"],
  ["eval", "(function(){var n=document.getElementById('gxNext');for(var i=0;i<4;i++)n.click();var k=document.querySelectorAll('#gxSteps .step:not([hidden])').length,a=!document.getElementById('gxAns').hidden;return (k===5&&a)?'PASS 5 steps + answer':'FAIL '+k+' steps ans='+a;})()"],
