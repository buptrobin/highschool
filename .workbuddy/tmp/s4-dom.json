[
  ["scroll", "figure:nth-of-type(1)"],
  ["eval", "document.querySelectorAll('.gx-zoomchip').length + '|' + getComputedStyle(document.querySelector('.gx-zoomchip')).pointerEvents + '|' + document.querySelectorAll('#gxZoom').length"],
  ["eval", "var z=document.querySelector('#gxZoom'); z.hidden + '|' + z.parentElement.className + '|' + z.outerHTML.slice(0,120)"],
  ["eval", "typeof window.GX + '|' + Object.keys(window.GX||{}).join(',')"]
]
