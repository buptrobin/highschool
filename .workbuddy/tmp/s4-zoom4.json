[
  ["scroll", "figure:nth-of-type(1)"],
  ["eval", "document.querySelector('.gx-zoomchip').click(); 'clicked'"],
  ["wait", 200],
  ["eval", "document.querySelector('#gxZoom').hidden + '|' + document.querySelectorAll('#gxZoomInner svg').length"],
  ["eval", "document.querySelector('#gxZoom').outerHTML.slice(0,200)"]
]
