[
  ["scroll", "figure:nth-of-type(1)"],
  ["click", ".gx-zoomchip"],
  ["wait", 200],
  ["eval", "document.querySelector('#gxZoom').hidden + '|' + document.querySelectorAll('#gxZoomInner svg').length + '|' + document.querySelector('#gxZoomInner svg').getAttribute('viewBox')"],
  ["click", ".gx-zoom-x"],
  ["wait", 100],
  ["eval", "document.querySelector('#gxZoom').hidden + '|' + document.querySelectorAll('#gxZoomInner svg').length"]
]
